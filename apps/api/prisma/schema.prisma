generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum VaiTro {
  KHACH_HANG
  NHAN_VIEN
  ADMIN
}

enum TrangThaiNhanVien {
  DANG_LAM
  TAM_NGHI
  NGHI_VIEC
}

enum TrangThaiPhanCa {
  DA_XEP
  DA_XAC_NHAN
  DA_HOAN_THANH
  VANG_MAT
  DA_HUY
}

enum TrangThaiSanPham {
  NHAP
  DANG_BAN
  TAM_AN
  NGUNG_BAN
}

enum TrangThaiDonHang {
  CHO_XAC_NHAN
  DA_XAC_NHAN
  DANG_SAN_XUAT
  DANG_GIAO
  HOAN_TAT
  DA_HUY
}

enum TrangThaiNguon {
  MAU_THAM_KHAO
  DUOC_PHEP_KINH_DOANH
}

model NguoiDung {
  id              String   @id @default(uuid()) @db.Uuid
  thu_dien_tu     String   @unique @db.VarChar(255)
  mat_khau_bam    String   @db.VarChar(500)
  ho_ten          String   @db.VarChar(150)
  so_dien_thoai   String?  @db.VarChar(30)
  vai_tro         VaiTro   @default(KHACH_HANG)
  da_kich_hoat    Boolean  @default(true)
  so_lan_dang_nhap_that_bai Int @default(0)
  khoa_den         DateTime? @db.Timestamptz(6)
  lan_dang_nhap_cuoi DateTime? @db.Timestamptz(6)
  phien_ban_mat_khau Int @default(1)
  ngay_tao        DateTime @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime @updatedAt @db.Timestamptz(6)
  don_hang        DonHang[]
  phien_dang_nhap PhienDangNhap[]
  gio_hang        GioHang[]
  dia_chi         DiaChiNguoiDung[]
  dat_lai_mat_khau DatLaiMatKhau[]
  nhan_vien       NhanVien?
  lich_su_don_hang LichSuDonHang[]

  @@map("nguoi_dung")
}

model DanhMuc {
  id            String    @id @default(uuid()) @db.Uuid
  ma_danh_muc   String    @unique @db.VarChar(50)
  ten_danh_muc  String    @db.VarChar(150)
  duong_dan     String    @unique @db.VarChar(160)
  mo_ta         String?   @db.Text
  thu_tu        Int       @default(0)
  dang_hien_thi Boolean   @default(true)
  san_pham      SanPham[]

  @@map("danh_muc")
}

model SanPham {
  id                  String            @id @default(uuid()) @db.Uuid
  ma_san_pham         String            @unique @db.VarChar(50)
  ten_san_pham        String            @db.VarChar(200)
  duong_dan           String            @unique @db.VarChar(220)
  mo_ta_ngan          String?           @db.VarChar(700)
  mo_ta               String?           @db.Text
  gia_ban             Decimal           @db.Decimal(14, 2)
  gia_von             Decimal?          @db.Decimal(14, 2)
  don_vi_tien_te      String            @default("VND") @db.Char(3)
  khoi_luong_gam      Decimal?          @db.Decimal(10, 2)
  thoi_gian_in_gio    Decimal?          @db.Decimal(10, 2)
  kich_thuoc          String?           @db.VarChar(120)
  thong_so            Json              @default("{}") @db.JsonB
  trang_thai          TrangThaiSanPham  @default(DANG_BAN)
  trang_thai_nguon    TrangThaiNguon    @default(MAU_THAM_KHAO)
  nguon_tham_khao     String?           @db.Text
  danh_muc_id         String            @db.Uuid
  danh_muc            DanhMuc           @relation(fields: [danh_muc_id], references: [id], onDelete: Restrict)
  hinh_anh            HinhAnhSanPham[]
  bien_the            BienTheSanPham[]
  yeu_thich           YeuThich[]
  danh_gia            DanhGiaSanPham[]
  ngay_tao            DateTime          @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat       DateTime          @updatedAt @db.Timestamptz(6)

  @@index([danh_muc_id])
  @@index([trang_thai])
  @@map("san_pham")
}

model HinhAnhSanPham {
  id            String   @id @default(uuid()) @db.Uuid
  san_pham_id   String   @db.Uuid
  duong_dan_anh String   @db.Text
  mo_ta_anh     String?  @db.VarChar(250)
  la_anh_chinh  Boolean  @default(false)
  thu_tu        Int      @default(0)
  san_pham      SanPham  @relation(fields: [san_pham_id], references: [id], onDelete: Cascade)

  @@index([san_pham_id])
  @@map("hinh_anh_san_pham")
}

model VatLieu {
  id             String          @id @default(uuid()) @db.Uuid
  ma_vat_lieu    String          @unique @db.VarChar(40)
  ten_vat_lieu   String          @db.VarChar(120)
  mo_ta          String?         @db.Text
  he_so_gia      Decimal         @default(1) @db.Decimal(8, 3)
  bien_the       BienTheSanPham[]

  @@map("vat_lieu")
}

model MauSac {
  id          String          @id @default(uuid()) @db.Uuid
  ma_mau      String          @unique @db.VarChar(40)
  ten_mau     String          @db.VarChar(120)
  ma_hex      String          @db.VarChar(9)
  bien_the    BienTheSanPham[]

  @@map("mau_sac")
}

model BienTheSanPham {
  id            String    @id @default(uuid()) @db.Uuid
  san_pham_id   String    @db.Uuid
  vat_lieu_id   String?   @db.Uuid
  mau_sac_id    String?   @db.Uuid
  ma_bien_the   String    @unique @db.VarChar(80)
  gia_chenh_lech Decimal  @default(0) @db.Decimal(14, 2)
  so_luong_ton  Int       @default(0)
  ton_toi_thieu Int       @default(0)
  ton_toi_da    Int       @default(0)
  dang_hien_thi Boolean   @default(true)
  san_pham      SanPham   @relation(fields: [san_pham_id], references: [id], onDelete: Cascade)
  vat_lieu      VatLieu?  @relation(fields: [vat_lieu_id], references: [id], onDelete: SetNull)
  mau_sac       MauSac?   @relation(fields: [mau_sac_id], references: [id], onDelete: SetNull)
  chi_tiet_gio_hang ChiTietGioHang[]
  chi_tiet_nhap_kho ChiTietPhieuNhapKho[]

  @@index([san_pham_id])
  @@map("bien_the_san_pham")
}


model NhaCungCap {
  id               String          @id @default(uuid()) @db.Uuid
  ma_nha_cung_cap  String          @unique @db.VarChar(50)
  ten_nha_cung_cap String          @db.VarChar(180)
  nguoi_lien_he    String?         @db.VarChar(120)
  so_dien_thoai    String?         @db.VarChar(30)
  thu_dien_tu      String?         @db.VarChar(190)
  dia_chi          String?         @db.Text
  ghi_chu          String?         @db.Text
  dang_hoat_dong   Boolean         @default(true)
  ngay_tao         DateTime        @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat    DateTime        @updatedAt @db.Timestamptz(6)
  phieu_nhap       PhieuNhapKho[]

  @@index([ten_nha_cung_cap])
  @@index([dang_hoat_dong])
  @@map("nha_cung_cap")
}

model PhieuNhapKho {
  id               String                 @id @default(uuid()) @db.Uuid
  ma_phieu         String                 @unique @db.VarChar(40)
  ma_lo            String?                @db.VarChar(80)
  nha_cung_cap     String?                @db.VarChar(180)
  nha_cung_cap_id  String?                @db.Uuid
  ghi_chu          String?                @db.Text
  nguoi_tao_id     String?                @db.Uuid
  so_dong          Int                    @default(0)
  tong_so_luong    Int                    @default(0)
  ngay_tao         DateTime               @default(now()) @db.Timestamptz(6)
  chi_tiet         ChiTietPhieuNhapKho[]
  nha_cung_cap_ref NhaCungCap?            @relation(fields: [nha_cung_cap_id], references: [id], onDelete: SetNull)

  @@index([ngay_tao])
  @@index([ma_lo])
  @@index([nha_cung_cap_id])
  @@map("phieu_nhap_kho")
}

model ChiTietPhieuNhapKho {
  id               String          @id @default(uuid()) @db.Uuid
  phieu_nhap_id    String          @db.Uuid
  bien_the_id      String          @db.Uuid
  ma_bien_the      String          @db.VarChar(80)
  so_luong_nhap    Int
  ton_truoc        Int
  ton_sau          Int
  ly_do            String?         @db.VarChar(300)
  ngay_tao         DateTime        @default(now()) @db.Timestamptz(6)
  phieu_nhap       PhieuNhapKho    @relation(fields: [phieu_nhap_id], references: [id], onDelete: Cascade)
  bien_the         BienTheSanPham  @relation(fields: [bien_the_id], references: [id], onDelete: Restrict)

  @@index([phieu_nhap_id])
  @@index([bien_the_id])
  @@index([ngay_tao])
  @@map("chi_tiet_phieu_nhap_kho")
}

model DonHang {
  id               String            @id @default(uuid()) @db.Uuid
  ma_don_hang      String            @unique @db.VarChar(40)
  nguoi_dung_id    String?           @db.Uuid
  ho_ten_nguoi_nhan String           @db.VarChar(150)
  so_dien_thoai    String            @db.VarChar(30)
  dia_chi_giao_hang String           @db.Text
  ghi_chu          String?           @db.Text
  tong_tien        Decimal           @db.Decimal(14, 2)
  trang_thai       TrangThaiDonHang  @default(CHO_XAC_NHAN)
  nguoi_dung       NguoiDung?        @relation(fields: [nguoi_dung_id], references: [id], onDelete: SetNull)
  chi_tiet         ChiTietDonHang[]
  thanh_toan       ThanhToan[]
  lich_su           LichSuDonHang[]
  ngay_tao         DateTime          @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat    DateTime          @updatedAt @db.Timestamptz(6)

  @@index([nguoi_dung_id])
  @@index([trang_thai])
  @@index([trang_thai, ngay_tao])
  @@index([ngay_tao])
  @@map("don_hang")
}

model LichSuDonHang {
  id                  BigInt            @id @default(autoincrement())
  don_hang_id         String            @db.Uuid
  nguoi_thuc_hien_id  String?           @db.Uuid
  trang_thai_cu       TrangThaiDonHang?
  trang_thai_moi      TrangThaiDonHang
  ghi_chu             String?           @db.VarChar(500)
  ngay_tao            DateTime          @default(now()) @db.Timestamptz(6)
  don_hang            DonHang           @relation(fields: [don_hang_id], references: [id], onDelete: Cascade)
  nguoi_thuc_hien     NguoiDung?        @relation(fields: [nguoi_thuc_hien_id], references: [id], onDelete: SetNull)

  @@index([don_hang_id, ngay_tao])
  @@index([nguoi_thuc_hien_id])
  @@map("lich_su_don_hang")
}

model ChiTietDonHang {
  id              String   @id @default(uuid()) @db.Uuid
  don_hang_id     String   @db.Uuid
  san_pham_id     String?  @db.Uuid
  ten_san_pham    String   @db.VarChar(200)
  ma_san_pham    String   @db.VarChar(50)
  so_luong        Int
  don_gia         Decimal  @db.Decimal(14, 2)
  thanh_tien      Decimal  @db.Decimal(14, 2)
  tuy_chon        Json     @default("{}") @db.JsonB
  don_hang        DonHang @relation(fields: [don_hang_id], references: [id], onDelete: Cascade)

  @@index([don_hang_id])
  @@map("chi_tiet_don_hang")
}

model PhienDangNhap {
  id                    String    @id @default(uuid()) @db.Uuid
  nguoi_dung_id          String    @db.Uuid
  ma_lam_moi_bam         String    @unique @db.VarChar(500)
  dia_chi_ip             String?   @db.VarChar(64)
  trinh_duyet             String?   @db.VarChar(500)
  het_han_luc             DateTime  @db.Timestamptz(6)
  da_thu_hoi              Boolean   @default(false)
  ngay_tao                DateTime  @default(now()) @db.Timestamptz(6)
  nguoi_dung              NguoiDung @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)

  @@index([nguoi_dung_id])
  @@map("phien_dang_nhap")
}

model DatLaiMatKhau {
  id             String    @id @default(uuid()) @db.Uuid
  nguoi_dung_id  String    @db.Uuid
  ma_bi_mat_bam  String    @unique @db.VarChar(64)
  het_han_luc    DateTime  @db.Timestamptz(6)
  da_su_dung     Boolean   @default(false)
  dia_chi_ip     String?   @db.VarChar(64)
  ngay_tao       DateTime  @default(now()) @db.Timestamptz(6)
  ngay_su_dung   DateTime? @db.Timestamptz(6)
  nguoi_dung     NguoiDung @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)

  @@index([nguoi_dung_id, da_su_dung])
  @@index([het_han_luc])
  @@index([ngay_tao])
  @@map("dat_lai_mat_khau")
}


model NhanVien {
  id             String              @id @default(uuid()) @db.Uuid
  nguoi_dung_id  String              @unique @db.Uuid
  ma_nhan_vien   String              @unique @db.VarChar(40)
  chuc_danh      String              @db.VarChar(120)
  bo_phan        String              @db.VarChar(120)
  ngay_vao_lam   DateTime            @db.Date
  trang_thai     TrangThaiNhanVien   @default(DANG_LAM)
  ghi_chu        String?             @db.Text
  ngay_tao       DateTime            @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat  DateTime            @updatedAt @db.Timestamptz(6)
  nguoi_dung     NguoiDung           @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)
  phan_ca        PhanCa[]

  @@index([trang_thai])
  @@index([bo_phan])
  @@map("nhan_vien")
}

model CaLamViec {
  id              String    @id @default(uuid()) @db.Uuid
  ma_ca           String    @unique @db.VarChar(40)
  ten_ca          String    @db.VarChar(120)
  gio_bat_dau     String    @db.VarChar(5)
  gio_ket_thuc    String    @db.VarChar(5)
  mau_hien_thi    String?   @db.VarChar(9)
  dang_hoat_dong  Boolean   @default(true)
  ngay_tao        DateTime  @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime  @updatedAt @db.Timestamptz(6)
  phan_ca         PhanCa[]

  @@index([dang_hoat_dong])
  @@map("ca_lam_viec")
}

model PhanCa {
  id              String            @id @default(uuid()) @db.Uuid
  nhan_vien_id    String            @db.Uuid
  ca_lam_viec_id  String            @db.Uuid
  ngay_lam        DateTime          @db.Date
  trang_thai      TrangThaiPhanCa   @default(DA_XEP)
  ghi_chu         String?           @db.Text
  ngay_tao        DateTime          @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime          @updatedAt @db.Timestamptz(6)
  nhan_vien       NhanVien          @relation(fields: [nhan_vien_id], references: [id], onDelete: Cascade)
  ca_lam_viec     CaLamViec         @relation(fields: [ca_lam_viec_id], references: [id], onDelete: Restrict)

  @@unique([nhan_vien_id, ca_lam_viec_id, ngay_lam])
  @@index([ngay_lam])
  @@index([trang_thai])
  @@map("phan_ca")
}

model NhatKyBaoMat {
  id            BigInt   @id @default(autoincrement())
  loai_su_kien  String   @db.VarChar(100)
  nguoi_dung_id String?  @db.Uuid
  dia_chi_ip    String?  @db.VarChar(64)
  chi_tiet      Json     @default("{}") @db.JsonB
  ngay_tao      DateTime @default(now()) @db.Timestamptz(6)

  @@index([loai_su_kien])
  @@index([ngay_tao])
  @@index([nguoi_dung_id, ngay_tao])
  @@index([loai_su_kien, ngay_tao])
  @@map("nhat_ky_bao_mat")
}


model LichSuVanHanh {
  id          BigInt   @id @default(autoincrement())
  loai        String   @db.VarChar(30)
  trang_thai  String   @db.VarChar(30)
  mo_ta       String?  @db.VarChar(500)
  chi_tiet    Json     @default("{}") @db.JsonB
  chu_ky_canh_bao String? @db.VarChar(64)
  ngay_bat_dau DateTime? @db.Timestamptz(6)
  ngay_ket_thuc DateTime? @db.Timestamptz(6)
  ngay_tao    DateTime @default(now()) @db.Timestamptz(6)
  search_vector Unsupported("tsvector")? @default(dbgenerated()) @map("search_vector")

  @@index([loai, ngay_tao])
  @@index([trang_thai, ngay_tao])
  @@index([chu_ky_canh_bao, ngay_tao])
  @@index([ngay_tao])
  @@map("lich_su_van_hanh")
}

model SuCoVanHanh {
  chu_ky                    String   @id @db.VarChar(64)
  trang_thai_xu_ly          String   @default("MOI") @db.VarChar(30)
  van_de                    Json     @default("[]") @db.JsonB
  bat_dau                   DateTime @db.Timestamptz(6)
  gan_nhat                  DateTime @db.Timestamptz(6)
  so_su_kien                Int      @default(0)
  so_health                 Int      @default(0)
  so_alert                  Int      @default(0)
  trang_thai_gan_nhat       String   @db.VarChar(30)
  ghi_chu                   String?  @db.Text
  nguoi_tiep_nhan_id        String?  @db.Uuid
  nguoi_tiep_nhan_ten       String?  @db.VarChar(150)
  tiep_nhan_luc             DateTime? @db.Timestamptz(6)
  nguoi_khac_phuc_id        String?  @db.Uuid
  nguoi_khac_phuc_ten       String?  @db.VarChar(150)
  khac_phuc_luc             DateTime? @db.Timestamptz(6)
  ngay_tao                  DateTime @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat             DateTime @updatedAt @db.Timestamptz(6)

  @@index([trang_thai_xu_ly, gan_nhat])
  @@index([gan_nhat])
  @@map("su_co_van_hanh")
}

model PhienBanSeed {
  id          BigInt   @id @default(autoincrement())
  phien_ban   String   @unique @db.VarChar(60)
  mo_ta       String   @db.VarChar(300)
  ngay_ap_dung DateTime @default(now()) @db.Timestamptz(6)

  @@map("phien_ban_seed")
}


enum TrangThaiGioHang {
  DANG_MO
  DA_DAT_HANG
  HET_HAN
}

enum TrangThaiThanhToan {
  CHO_THANH_TOAN
  DA_THANH_TOAN
  THAT_BAI
  DA_HOAN_TIEN
}

model GioHang {
  id              String           @id @default(uuid()) @db.Uuid
  ma_phien        String           @unique @db.VarChar(120)
  nguoi_dung_id   String?          @db.Uuid
  trang_thai      TrangThaiGioHang @default(DANG_MO)
  ngay_het_han    DateTime         @db.Timestamptz(6)
  ngay_tao        DateTime         @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime         @updatedAt @db.Timestamptz(6)
  nguoi_dung      NguoiDung?       @relation(fields: [nguoi_dung_id], references: [id], onDelete: SetNull)
  chi_tiet        ChiTietGioHang[]

  @@index([nguoi_dung_id])
  @@index([trang_thai])
  @@map("gio_hang")
}

model ChiTietGioHang {
  id              String          @id @default(uuid()) @db.Uuid
  gio_hang_id     String          @db.Uuid
  bien_the_id     String          @db.Uuid
  so_luong        Int
  don_gia         Decimal         @db.Decimal(14, 2)
  ngay_tao        DateTime        @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime        @updatedAt @db.Timestamptz(6)
  gio_hang        GioHang         @relation(fields: [gio_hang_id], references: [id], onDelete: Cascade)
  bien_the        BienTheSanPham  @relation(fields: [bien_the_id], references: [id], onDelete: Restrict)

  @@unique([gio_hang_id, bien_the_id])
  @@index([gio_hang_id])
  @@index([bien_the_id])
  @@map("chi_tiet_gio_hang")
}

model PhuongThucThanhToan {
  id              String       @id @default(uuid()) @db.Uuid
  ma_phuong_thuc  String       @unique @db.VarChar(50)
  ten_phuong_thuc String       @db.VarChar(150)
  mo_ta           String?      @db.Text
  dang_hoat_dong  Boolean      @default(false)
  thu_tu          Int          @default(0)
  thanh_toan      ThanhToan[]

  @@map("phuong_thuc_thanh_toan")
}

model ThanhToan {
  id                  String                @id @default(uuid()) @db.Uuid
  don_hang_id         String                @db.Uuid
  phuong_thuc_id      String                @db.Uuid
  ma_giao_dich        String                @unique @db.VarChar(80)
  so_tien             Decimal               @db.Decimal(14, 2)
  trang_thai          TrangThaiThanhToan    @default(CHO_THANH_TOAN)
  noi_dung            String?               @db.Text
  ngay_thanh_toan     DateTime?             @db.Timestamptz(6)
  ngay_tao            DateTime              @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat       DateTime              @updatedAt @db.Timestamptz(6)
  don_hang            DonHang               @relation(fields: [don_hang_id], references: [id], onDelete: Cascade)
  phuong_thuc         PhuongThucThanhToan   @relation(fields: [phuong_thuc_id], references: [id], onDelete: Restrict)

  @@index([don_hang_id])
  @@index([phuong_thuc_id])
  @@index([trang_thai])
  @@map("thanh_toan")
}

model DiaChiNguoiDung {
  id              String      @id @default(uuid()) @db.Uuid
  nguoi_dung_id   String      @db.Uuid
  ten_nguoi_nhan  String      @db.VarChar(150)
  so_dien_thoai   String      @db.VarChar(30)
  tinh_thanh      String      @db.VarChar(120)
  quan_huyen      String      @db.VarChar(120)
  phuong_xa       String      @db.VarChar(120)
  dia_chi_cu_the  String      @db.Text
  la_mac_dinh     Boolean     @default(false)
  ngay_tao        DateTime    @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat   DateTime    @updatedAt @db.Timestamptz(6)
  nguoi_dung      NguoiDung   @relation(fields: [nguoi_dung_id], references: [id], onDelete: Cascade)

  @@index([nguoi_dung_id])
  @@map("dia_chi_nguoi_dung")
}


model YeuThich {
  id          String   @id @default(uuid()) @db.Uuid
  ma_phien    String   @db.VarChar(120)
  san_pham_id String   @db.Uuid
  ngay_tao    DateTime @default(now()) @db.Timestamptz(6)
  san_pham    SanPham  @relation(fields: [san_pham_id], references: [id], onDelete: Cascade)

  @@unique([ma_phien, san_pham_id])
  @@index([ma_phien])
  @@index([san_pham_id])
  @@map("yeu_thich")
}


model DanhGiaSanPham {
  id            String   @id @default(uuid()) @db.Uuid
  san_pham_id   String   @db.Uuid
  ma_phien      String   @db.VarChar(120)
  ho_ten        String   @db.VarChar(120)
  so_sao        Int
  noi_dung      String   @db.VarChar(1500)
  da_duyet      Boolean  @default(false)
  ngay_tao      DateTime @default(now()) @db.Timestamptz(6)
  ngay_cap_nhat DateTime @updatedAt @db.Timestamptz(6)
  san_pham      SanPham  @relation(fields: [san_pham_id], references: [id], onDelete: Cascade)

  @@unique([ma_phien, san_pham_id])
  @@index([san_pham_id, da_duyet])
  @@index([ngay_tao])
  @@map("danh_gia_san_pham")
}

model CauHinhHeThong {
  khoa              String   @id @db.VarChar(100)
  gia_tri           Json     @db.JsonB
  nguoi_cap_nhat_id String?  @db.Uuid
  ngay_cap_nhat     DateTime @updatedAt @db.Timestamptz(6)

  @@map("cau_hinh_he_thong")
}
