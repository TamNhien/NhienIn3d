POSTGRES_DB=nhienin3d
POSTGRES_USER=nhienin3d_app
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH_IT_NHAT_24_KY_TU
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
API_PORT=3001
WEB_PORT=3000
JWT_SECRET=DOI_CHUOI_BI_MAT_NGAU_NHIEN_IT_NHAT_64_KY_TU
COOKIE_SECRET=DOI_CHUOI_BI_MAT_COOKIE_IT_NHAT_32_KY_TU
ADMIN_EMAIL=admin@nhienin3d.local
ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN_MANH
ADMIN_NAME="System Admin"
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://localhost:3000,http://localhost:3000
# development: cho phép giả lập gateway online; production: chỉ cho phép phương thức đã tích hợp thật
NODE_ENV=development

# Email SMTP v2.8.2 - Gmail / Google Workspace / SMTP tuong thich
# KHONG commit .env that. Neu dung Gmail, bat 2-Step Verification va tao App Password rieng.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM="NhienIn3d <your-account@gmail.com>"
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
MAIL_TLS_REJECT_UNAUTHORIZED=true
WEB_PUBLIC_URL=https://localhost:3000
RESET_PASSWORD_EXPIRES_MINUTES=15
# Mailpit chi dung khi muon test SMTP noi bo bang profile mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# v2.18.0 - canh bao ton kho qua email. Chi gui lai khi danh sach/so luong canh bao thay doi.
LOW_STOCK_EMAIL_ENABLED=false
LOW_STOCK_EMAIL_INTERVAL_MINUTES=60
# De trong de tu dong gui den tat ca tai khoan ADMIN dang hoat dong; hoac nhap danh sach email cach nhau boi dau phay.
LOW_STOCK_EMAIL_TO=

# v3.2.0 - cảnh báo vận hành. Để nhận cảnh báo ngay cả khi DB lỗi, nên cấu hình SYSTEM_HEALTH_EMAIL_TO cố định.
SYSTEM_HEALTH_EMAIL_ENABLED=false
SYSTEM_HEALTH_EMAIL_INTERVAL_MINUTES=30
SYSTEM_HEALTH_EMAIL_TO=
SYSTEM_HEALTH_BACKUP_MAX_AGE_HOURS=36
# v3.3.0 - cung mot su co se im lang truoc khi gui lai; neu keo dai se leo thang theo cap.
SYSTEM_HEALTH_ALERT_SILENCE_MINUTES=180
SYSTEM_HEALTH_ALERT_ESCALATION_MINUTES=720
