POSTGRES_DB=nhienin3d
POSTGRES_USER=nhienin3d_app
POSTGRES_PASSWORD=DOI_MAT_KHAU_MANH_IT_NHAT_24_KY_TU
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
API_PORT=3001
API_RATE_LIMIT_MAX=600
WEB_PORT=3000
JWT_SECRET=DOI_CHUOI_BI_MAT_NGAU_NHIEN_IT_NHAT_64_KY_TU
COOKIE_SECRET=DOI_CHUOI_BI_MAT_COOKIE_IT_NHAT_32_KY_TU
ADMIN_EMAIL=admin@nhienin3d.local
ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN_MANH
ADMIN_NAME="System Admin"
NEXT_PUBLIC_API_URL=/api/v1
CORS_ORIGIN=https://localhost:3000,http://localhost:3000
# development: cho phép giả lập gateway online; production: chỉ cho phép phương thức đã tích hợp thật
NODE_ENV=development

# Email SMTP v2.8.2 - Gmail / Google Workspace / SMTP tuong thich
# KHONG commit .env that. Neu dung Gmail, bat 2-Step Verification va tao App Password rieng.
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM="NhienIn3d <your-account@gmail.com>"
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
MAIL_TLS_REJECT_UNAUTHORIZED=true
WEB_PUBLIC_URL=https://localhost:3000
RESET_PASSWORD_EXPIRES_MINUTES=15
# Mailpit chi dung khi muon test SMTP noi bo bang profile mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# v2.18.0 - canh bao ton kho qua email. Chi gui lai khi danh sach/so luong canh bao thay doi.
LOW_STOCK_EMAIL_ENABLED=false
LOW_STOCK_EMAIL_INTERVAL_MINUTES=60
# De trong de tu dong gui den tat ca tai khoan ADMIN dang hoat dong; hoac nhap danh sach email cach nhau boi dau phay.
LOW_STOCK_EMAIL_TO=

# v3.2.0 - cảnh báo vận hành. Để nhận cảnh báo ngay cả khi DB lỗi, nên cấu hình SYSTEM_HEALTH_EMAIL_TO cố định.
SYSTEM_HEALTH_EMAIL_ENABLED=false
SYSTEM_HEALTH_EMAIL_INTERVAL_MINUTES=30
SYSTEM_HEALTH_EMAIL_TO=
SYSTEM_HEALTH_BACKUP_MAX_AGE_HOURS=36
# v3.3.0 - cung mot su co se im lang truoc khi gui lai; neu keo dai se leo thang theo cap.
SYSTEM_HEALTH_ALERT_SILENCE_MINUTES=180
SYSTEM_HEALTH_ALERT_ESCALATION_MINUTES=720

# v3.5.0 - mục tiêu SLO và cảnh báo xu hướng 7/30 ngày. Admin có thể override trong database.
SYSTEM_SLO_SLA_TARGET_PERCENT=99
SYSTEM_SLO_UPTIME_TARGET_PERCENT=99.9
SYSTEM_SLO_TREND_ALERT_ENABLED=true

# v3.6.0 - webhook cảnh báo ngoài (mặc định tắt; production chỉ chấp nhận HTTPS).
SYSTEM_ALERT_WEBHOOK_ENABLED=false
SYSTEM_ALERT_WEBHOOK_URL=
SYSTEM_ALERT_WEBHOOK_ADAPTER=GENERIC
SYSTEM_SLO_ENDPOINT_INTERVAL_MINUTES=5
SYSTEM_ALERT_WEBHOOK_BEARER_TOKEN=
SYSTEM_ALERT_WEBHOOK_SECRET=
SYSTEM_ALERT_WEBHOOK_MAX_RETRIES=3
SYSTEM_ALERT_WEBHOOK_BACKOFF_MS=750
SYSTEM_ALERT_WEBHOOK_DLQ_RETENTION_DAYS=30
SYSTEM_ALERT_WEBHOOK_REPLAY_ALLOW_DUPLICATE=false
SYSTEM_SLO_PROBE_BEARER_TOKEN=
SYSTEM_SLO_PROBE_AGENT_ID=local-agent
SYSTEM_SLO_PROBE_REGION=local
SYSTEM_SLO_PROBE_NODE=local
SYSTEM_ALERT_WEBHOOK_DLQ_ENCRYPTION_KEY=
SYSTEM_ALERT_WEBHOOK_DLQ_RETRY_INTERVAL_MINUTES=15
SYSTEM_ALERT_WEBHOOK_DLQ_SCHEDULED_MAX_ATTEMPTS=5
SYSTEM_OPS_METRICS_REFRESH_MINUTES=5
SYSTEM_OPS_HISTORY_RETENTION_DAYS=180

# v3.11.0 - distributed signed probe ingestion/heartbeat.
# Có thể dùng shared secret hoặc keyring JSON theo agent. Secret thật không commit vào Git.
SYSTEM_SLO_AGENT_SHARED_SECRET=
SYSTEM_SLO_AGENT_KEYS_JSON=
SYSTEM_SLO_AGENT_MAX_CLOCK_SKEW_SECONDS=300
# v3.12.0 - managed probe fleet health/coverage. Không chứa secret.
# Ví dụ profile (không chứa secret): [{"agent_id":"agent-hcm-01","region":"hcm","node_name":"server-hcm-01","required":true},{"agent_id":"agent-hn-01","region":"hanoi","node_name":"server-hn-01","required":true},{"agent_id":"agent-local","region":"local","node_name":"server-local-01","required":true}]
SYSTEM_SLO_AGENT_PROFILES_JSON=
SYSTEM_SLO_AGENT_STALE_AFTER_SECONDS=600
SYSTEM_SLO_AGENT_OFFLINE_AFTER_SECONDS=1800
# v3.14.0 - Ed25519 public-key ring. Giữ tương thích string/array v3.13 và hỗ trợ descriptor lifecycle:
# {"agent-hcm-01":[{"key_id":"hcm-2026-09","public_key":"${ENV:HCM_PUB}","status":"ACTIVE","not_before":"2026-09-01T00:00:00Z","expires_at":"2026-12-01T00:00:00Z"}]}
# status: ACTIVE/GRACE/DISABLED/REVOKED; revoked=true cũng thu hồi key. API không trả raw public/private key trên Ops runtime.
SYSTEM_SLO_AGENT_PUBLIC_KEYS_JSON=
SYSTEM_SLO_AGENT_KEY_EXPIRY_WARN_DAYS=14
# Multi-region quorum + latency/status anomaly detection.
SYSTEM_SLO_QUORUM_WINDOW_SECONDS=900
SYSTEM_SLO_QUORUM_MIN_REGIONS=2
SYSTEM_SLO_QUORUM_HEALTHY_PERCENT=67
SYSTEM_SLO_QUORUM_ALERT_ENABLED=true
SYSTEM_SLO_ANOMALY_LOOKBACK_MINUTES=60
SYSTEM_SLO_ANOMALY_MIN_SAMPLES=6
SYSTEM_SLO_ANOMALY_LATENCY_MULTIPLIER=2.5
# v3.15.0 - self-service Ed25519 enrollment. Tạo secret ngẫu nhiên >=32 ký tự ở server; không commit giá trị thật.
SYSTEM_SLO_ENROLLMENT_SECRET=
SYSTEM_SLO_ENROLLMENT_TTL_MINUTES=30
# v3.16.0 - device identity binding + rotation policy cho agent enrolled.
SYSTEM_SLO_ENROLLMENT_REQUIRE_DEVICE_ID=false
SYSTEM_SLO_ENROLLMENT_ROTATION_DAYS=90
# Service dependency map + endpoint-to-service để tính blast radius.
SYSTEM_OPS_SERVICE_DEPENDENCIES_JSON='{"storefront":["api"],"checkout":["api","postgresql"],"ops":["api","postgresql"],"api":["postgresql"],"email":["smtp"],"backup":["postgresql"]}'
SYSTEM_SLO_ENDPOINT_SERVICE_MAP_JSON='{"public-health":"api"}'
# v3.17.0 - signed desired-state delivery; default paused/0% rollout. No remote command execution.
SYSTEM_SLO_PROBE_DESIRED_TARGET_VERSION=3.18.0
SYSTEM_SLO_PROBE_DESIRED_INTERVAL_SECONDS=300
SYSTEM_SLO_PROBE_DESIRED_ROLLOUT_PERCENT=0
SYSTEM_SLO_PROBE_DESIRED_CANARY_AGENTS=
SYSTEM_SLO_PROBE_DESIRED_PAUSED=true
# Ed25519 ký desired-state từ server. Mặc định để trống => rollout fail-closed (SIGNING_REQUIRED), không áp dụng cấu hình từ xa.
SYSTEM_SLO_PROBE_DESIRED_SIGNING_PRIVATE_KEY=
SYSTEM_SLO_PROBE_DESIRED_SIGNING_KEY_ID=desired-state-v3170

# Standalone probe-agent script (scripts/probe-agent-v3180.mjs)
NH3D_PROBE_API_URL=http://localhost:3001/api/v1
NH3D_PROBE_AGENT_ID=agent-local
NH3D_PROBE_REGION=local
NH3D_PROBE_NODE=
NH3D_PROBE_AGENT_SECRET=
# Chỉ cần khi enroll node Ed25519 mới. Token dùng một lần; public/private key do agent tự tạo local.
NH3D_PROBE_ENROLLMENT_TOKEN=
NH3D_PROBE_AGENT_KEY_ID=
NH3D_PROBE_AGENT_PUBLIC_KEY_FILE=
# Device identity chỉ gửi qua header; server chỉ lưu SHA-256 hash, không lưu raw ID.
NH3D_PROBE_DEVICE_ID=
# Nếu dùng Ed25519, đặt private key inline hoặc đường dẫn file; private key không commit vào Git.
NH3D_PROBE_AGENT_PRIVATE_KEY=
NH3D_PROBE_AGENT_PRIVATE_KEY_FILE=
# Public key dùng để xác minh desired-state do server ký. Không có key này thì agent giữ HOLD, không áp dụng rollout.
NH3D_PROBE_DESIRED_STATE_PUBLIC_KEY=
NH3D_PROBE_DESIRED_STATE_PUBLIC_KEY_FILE=
NH3D_PROBE_DESIRED_STATE_MAX_AGE_SECONDS=600
NH3D_PROBE_INTERVAL_SECONDS=300
# Để trống để probe mặc định /suc-khoe với timeout 5000 ms; hoặc truyền JSON array endpoint riêng.
NH3D_PROBE_ENDPOINTS_JSON=

# v3.11.0 - DLQ keyring/KMS-friendly references + destination retry budget.
SYSTEM_ALERT_WEBHOOK_DLQ_KEYRING_JSON=
SYSTEM_ALERT_WEBHOOK_DLQ_ACTIVE_KEY_ID=
SYSTEM_ALERT_WEBHOOK_DLQ_DESTINATION_MAX_ATTEMPTS=30
SYSTEM_ALERT_WEBHOOK_DLQ_DESTINATION_WINDOW_MINUTES=60

# v3.11.0 - archive/verify-before-prune. Mặc định KHÔNG xóa telemetry trực tiếp.
SYSTEM_OPS_RETENTION_HEALTH_DAYS=90
SYSTEM_OPS_RETENTION_SLO_ENDPOINT_DAYS=90
SYSTEM_OPS_RETENTION_WEBHOOK_DAYS=180
SYSTEM_OPS_RETENTION_DEFAULT_DAYS=365
SYSTEM_OPS_DIRECT_PRUNE_ENABLED=false
# v3.16.0 - portable archive JSONL+GZIP + S3-compatible presigned PUT allowlist.
SYSTEM_OPS_ARCHIVE_RETENTION_CLASS=STANDARD
# Danh sách hostname object storage được phép, cách nhau dấu phẩy. Ví dụ: s3.example.com,minio.example.com
SYSTEM_OPS_ARCHIVE_S3_ALLOWED_HOSTS=

# v3.17.0 - database recovery objectives/readiness. Logical recovery drill runs in verify:full.
SYSTEM_DB_RECOVERY_RPO_TARGET_MINUTES=60
SYSTEM_DB_RECOVERY_RTO_TARGET_MINUTES=30
SYSTEM_DB_RECOVERY_DRILL_MAX_AGE_DAYS=30
# Optional: enable WAL archiving with docker-compose.pitr.yml; safe drill does not claim a target-time PITR restore.

# v3.18.0 - health-gated canary, target-time PITR rehearsal, postmortem governance.
SYSTEM_SLO_PROBE_HEALTH_GATE_ENABLED=true
SYSTEM_SLO_PROBE_HEALTH_GATE_AUTO_ROLLBACK=true
SYSTEM_SLO_PROBE_HEALTH_GATE_MIN_ONLINE_PERCENT=80
SYSTEM_SLO_PROBE_HEALTH_GATE_MAX_QUORUM_FAILURES=0
SYSTEM_SLO_PROBE_HEALTH_GATE_GRACE_SECONDS=300
SYSTEM_SLO_PROBE_HEALTH_GATE_CHECK_MINUTES=2
SYSTEM_DB_PITR_DRILL_ENABLED=false
SYSTEM_INCIDENT_ACTION_REMINDER_ENABLED=false
SYSTEM_INCIDENT_ACTION_REMINDER_INTERVAL_HOURS=6
SYSTEM_INCIDENT_ACTION_REMINDER_DUE_SOON_DAYS=3
SYSTEM_OPS_SERVICE_RUNBOOKS_JSON={}
