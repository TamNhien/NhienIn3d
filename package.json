{
  "name": "nhienin3d",
  "private": true,
  "version": "3.19.0",
  "description": "NhienIn3d - cửa hàng sản phẩm in 3D hiện đại",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.17.0"
  },
  "scripts": {
    "test": "node scripts/don-dep-legacy.mjs && npm run test:root && npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspace=@nhienin3d/api && npm run build --workspace=@nhienin3d/web",
    "check": "npm test && npm run typecheck",
    "ci": "npm install && npm run check && npm run build && npm run audit:security",
    "cai-dat": "npm install",
    "kiem-tra": "npm run check",
    "dev:api": "npm run dev --workspace=@nhienin3d/api",
    "dev:web": "npm run dev --workspace=@nhienin3d/web",
    "db:generate": "npm run db:generate --workspace=@nhienin3d/api",
    "db:migrate": "npm run db:migrate --workspace=@nhienin3d/api",
    "db:seed": "npm run db:seed --workspace=@nhienin3d/api",
    "test:root": "node --test tests/*.test.mjs",
    "audit:security": "npm run security:mysql2 && npm audit --audit-level=high",
    "db:kiem-tra-du-lieu": "npm run db:kiem-tra-du-lieu --workspace=@nhienin3d/api",
    "mail:kiem-tra": "npm run mail:kiem-tra --workspace=@nhienin3d/api",
    "dev:web:https": "npm run dev:https --workspace=@nhienin3d/web",
    "https:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/https-local.ps1",
    "docker:up": "docker compose up -d --build --remove-orphans",
    "docker:ps": "docker compose ps",
    "e2e:browser": "node scripts/e2e-browser-v3190.mjs",
    "probe:agent": "node scripts/probe-agent-v3190.mjs",
    "security:mysql2": "node scripts/kiem-tra-mysql2-security.mjs",
    "probe:fleet": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-fleet-v3190.ps1",
    "probe:fleet:once": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-fleet-v3190.ps1 -Once",
    "probe:keygen": "node scripts/probe-keygen-v3190.mjs",
    "probe:enroll": "node scripts/probe-enroll-v3190.mjs",
    "probe:enrollment-token": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/probe-enrollment-token-v3190.ps1",
    "verify": "npm run verify:v319",
    "verify:full": "npm run verify:full:v319",
    "verify:v316": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3160.ps1",
    "verify:full:v316": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3160.ps1 -Full",
    "recovery:drill": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery-drill-v3190.ps1",
    "verify:v317": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3170.ps1",
    "verify:full:v317": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3170.ps1 -Full",
    "recovery:pitr": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/recovery-pitr-drill-v3190.ps1",
    "verify:v318": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3180.ps1",
    "verify:full:v318": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3180.ps1 -Full",
    "verify:v319": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3190.ps1",
    "verify:full:v319": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-v3190.ps1 -Full"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "fast-uri": "3.1.6",
    "lodash": "4.18.1",
    "js-yaml": "4.3.2",
    "mysql2": "$mysql2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "mysql2": "3.23.4"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "@scarf/scarf": false,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false,
    "prisma@7.10.0": true
  }
}
